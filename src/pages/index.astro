---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SpeciesExplorer from '../components/islands/SpeciesExplorer';
import ViverosExplorer from '../components/islands/ViverosExplorer';
import Calendario from '../components/sections/Calendario.astro';
import Hero from '../components/sections/Hero.astro';
import MarqueeEspecies from '../components/sections/MarqueeEspecies.astro';
import Proyecto from '../components/sections/Proyecto.astro';
import Voluntariado from '../components/sections/Voluntariado.astro';
import Base from '../layouts/Base.astro';
import { cargarJornadasSeguro } from '../lib/portaldeb/jornadas';
import { cargarResumenSeguro } from '../lib/portaldeb/resumen';

// Nivel 1: datos de PortalDEB al compilar (SEO y respaldo si la API no responde).
// Nivel 2: las islas los refrescan en el navegador con TanStack Query.
const [resumen, jornadas] = await Promise.all([cargarResumenSeguro(), cargarJornadasSeguro()]);
---

<Base
  title="Árboles para El Salvador · Solicita árboles gratis"
  description="Solicita árboles gratis de los viveros del MARN, conoce las especies disponibles y súmate a las jornadas de reforestación en El Salvador."
>
  <Header />
  <main id="contenido">
    <Hero resumen={resumen} />

    <div class="relative z-10 -mb-14">
      <MarqueeEspecies especies={resumen?.especies ?? []} />
    </div>

    <Proyecto />

    <section id="especies" class="bg-crema py-28" aria-labelledby="especies-titulo">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="mb-12 grid gap-6 lg:grid-cols-2 lg:items-end">
          <div>
            <p class="eyebrow text-olivo">Catálogo en vivo</p>
            <h2 id="especies-titulo" class="titulo mt-4 text-[clamp(3rem,7vw,6rem)]">
              ¿Qué quieres <em class="font-serif font-normal tracking-normal text-verde">sembrar?</em>
            </h2>
          </div>
          <p class="text-lg text-marino/70">
            Maderables, frutales y especies nativas que hoy tienen plantas listas en al menos un vivero del MARN. No es
            la lista de todas las especies del país: cambia según lo que producen los viveros y se actualiza
            constantemente.
          </p>
        </div>
        <SpeciesExplorer client:visible inicial={resumen?.especies ?? null} />
      </div>
    </section>

    <section id="viveros" class="bg-verde-50 py-28" aria-labelledby="viveros-titulo">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="mb-12 grid gap-6 lg:grid-cols-2 lg:items-end">
          <div>
            <p class="eyebrow text-olivo">Red de viveros</p>
            <h2 id="viveros-titulo" class="titulo mt-4 text-[clamp(3rem,7vw,6rem)]">
              Encuentra tu vivero <em class="font-serif font-normal tracking-normal text-verde">más cercano</em>
            </h2>
          </div>
          <p class="text-lg text-marino/70">
            Los viveros están en áreas naturales protegidas de todo el país. Selecciona uno para ver qué especies tiene
            disponibles.
          </p>
        </div>
        <ViverosExplorer client:visible inicial={resumen?.viveros ?? null} />
      </div>
    </section>

    <Calendario jornadas={jornadas} />
    <Voluntariado />
  </main>
  <Footer />
</Base>

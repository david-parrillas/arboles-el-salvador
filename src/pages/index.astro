---
import Flecha from '../components/Flecha.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/sections/Hero.astro';
import MarqueeEspecies from '../components/sections/MarqueeEspecies.astro';
import Proyecto from '../components/sections/Proyecto.astro';
import Voluntariado from '../components/sections/Voluntariado.astro';
import { enlaces, ruta } from '../config/site';
import Base from '../layouts/Base.astro';
import { cargarResumenSeguro } from '../lib/portaldeb/build';

// Nivel 1: datos de PortalDEB al compilar (SEO y respaldo si la API no responde).
// Nivel 2: las islas los refrescan en el navegador con TanStack Query vía /api/* (proxy con el token).
const resumen = await cargarResumenSeguro();
---

<Base
  title="Árboles para El Salvador · Solicita árboles gratis"
  description="Solicita árboles gratis de los viveros del MARN, conoce las especies disponibles y encuentra tu vivero más cercano en El Salvador."
>
  <Header />
  <main id="contenido">
    <Hero resumen={resumen} />

    <div class="relative z-10 -mb-14">
      <MarqueeEspecies especies={resumen?.especies ?? []} />
    </div>

    <Proyecto />

    <section id="especies" class="bg-crema py-28" aria-labelledby="especies-titulo">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
          <div>
            <p class="eyebrow text-olivo">Solicitud de plantas</p>
            <h2 id="especies-titulo" class="titulo mt-4 text-[clamp(3rem,7vw,6rem)]">
              ¿Qué quieres <em class="font-serif font-normal tracking-normal text-verde">sembrar?</em>
            </h2>
          </div>
          <p class="text-lg text-marino/70">
            El inventario de especies maderables, frutales, ornamentales y nativas disponibles actualmente en los
            viveros del MARN, el cual representa una selección sujeta a la capacidad productiva existente en cada vivero
            y no a la diversidad total del país.
          </p>
        </div>

        <div class="mt-12 flex flex-col items-start justify-between gap-6 rounded-[2rem] bg-verde p-8 text-white md:flex-row md:items-center md:p-10">
          <p class="titulo text-3xl md:text-4xl">
            Solicitar plantas <span class="text-lima">sin costo</span> llenando el formulario en línea.
          </p>
          <div class="flex shrink-0 flex-wrap gap-3">
            <a
              href={enlaces.solicitudArboles}
              class="rounded-full bg-lima px-7 py-4 font-bold text-marino transition hover:bg-lima-300"
            >
              Solicitar plantas <Flecha class="ml-1.5 size-[1em] align-[-0.125em]" />
            </a>
            <a
              href={ruta('especies')}
              class="rounded-full border-2 border-white/40 px-7 py-4 font-semibold transition hover:border-white"
            >
              Ver catálogo de especies
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="viveros" class="bg-verde-50 py-28" aria-labelledby="viveros-titulo">
      <div class="mx-auto grid max-w-7xl gap-6 px-4 sm:px-6 lg:grid-cols-2 lg:items-end">
        <div>
          <p class="eyebrow text-olivo">Red de viveros</p>
          <h2 id="viveros-titulo" class="titulo mt-4 text-[clamp(3rem,7vw,6rem)]">
            Encuentra tu vivero <em class="font-serif font-normal tracking-normal text-verde">más cercano</em>
          </h2>
        </div>
        <div>
          <p class="text-lg text-marino/70">
            Los viveros están en Áreas Naturales Protegidas de todo el país. Ubica en el mapa el más cercano a ti y su
            dirección.
          </p>
          <a
            href={ruta('viveros')}
            class="mt-6 inline-flex rounded-full bg-olivo px-7 py-4 font-bold text-white transition hover:bg-verde"
          >
            Ver mapa de viveros
          </a>
        </div>
      </div>
    </section>

    <Voluntariado />
  </main>
  <Footer />
</Base>

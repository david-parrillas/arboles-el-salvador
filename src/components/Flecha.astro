---
// Flechas en SVG: los caracteres ↗ ↓ ← se muestran como emoji en Windows.
interface Props {
  direccion?: 'externa' | 'abajo' | 'atras';
  class?: string;
}

const { direccion = 'externa', class: clase = 'size-4' } = Astro.props;

const trazos = {
  externa: 'M7 17 17 7M8 7h9v9',
  abajo: 'M12 5v14M6 13l6 6 6-6',
  atras: 'M19 12H5M11 6l-6 6 6 6',
};
---

<svg
  viewBox="0 0 24 24"
  class:list={['inline-block shrink-0', clase]}
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={trazos[direccion]}></path>
</svg>

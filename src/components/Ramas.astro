---
interface Props {
  class?: string;
}
const { class: clase } = Astro.props;

// Generador pseudoaleatorio con semilla fija: las ramas salen igual en cada build.
let semilla = 11;
const azar = () => {
  semilla = (semilla * 16807) % 2147483647;
  return (semilla - 1) / 2147483646;
};

type Punto = [number, number];
type Rama = { desde: Punto; control: Punto; hasta: Punto; grosor: number; hojas: number };

// Punto y ángulo (en grados) de una curva cuadrática en t.
const enCurva = ({ desde, control, hasta }: Rama, t: number) => {
  const u = 1 - t;
  const x = u * u * desde[0] + 2 * u * t * control[0] + t * t * hasta[0];
  const y = u * u * desde[1] + 2 * u * t * control[1] + t * t * hasta[1];
  const dx = 2 * u * (control[0] - desde[0]) + 2 * t * (hasta[0] - control[0]);
  const dy = 2 * u * (control[1] - desde[1]) + 2 * t * (hasta[1] - control[1]);
  return { x, y, angulo: (Math.atan2(dy, dx) * 180) / Math.PI };
};

// Ramas principales que entran desde la esquina superior derecha.
const principales: Rama[] = [
  { desde: [560, -20], control: [420, 30], hasta: [130, 110], grosor: 11, hojas: 16 },
  { desde: [560, 70], control: [440, 120], hasta: [290, 270], grosor: 8, hojas: 12 },
  { desde: [540, -30], control: [500, 110], hasta: [470, 330], grosor: 6, hojas: 10 },
];

// Ramitas que nacen de las principales.
const brote = (madre: Rama, t: number, hasta: Punto, control: Punto, hojas: number): Rama => {
  const { x, y } = enCurva(madre, t);
  return { desde: [x, y], control, hasta, grosor: madre.grosor * 0.45, hojas };
};
const grupos = [
  [
    principales[0],
    brote(principales[0], 0.45, [300, 190], [350, 120], 8),
    brote(principales[0], 0.7, [200, 20], [250, 50], 7),
    brote(principales[0], 0.88, [90, 200], [140, 150], 6),
  ],
  [principales[1], brote(principales[1], 0.55, [400, 330], [370, 270], 7), brote(principales[1], 0.8, [210, 230], [250, 230], 5)],
  [principales[2], brote(principales[2], 0.6, [400, 240], [440, 210], 5)],
];

// Rosados del maquilishuat, el árbol nacional.
const tonos = ['var(--color-rosa)', 'var(--color-rosa-400)', 'var(--color-rosa-600)', 'var(--color-rosa-400)'];

// Hojas alternadas a cada lado de la rama, más un racimo en la punta.
const hojasDe = (rama: Rama) => {
  const hojas = Array.from({ length: rama.hojas }, (_, i) => {
    const t = 0.12 + (0.88 * (i + 1)) / (rama.hojas + 1);
    const { x, y, angulo } = enCurva(rama, t);
    const lado = i % 2 ? 1 : -1;
    return {
      x,
      y,
      giro: angulo + lado * (35 + azar() * 35),
      escala: 0.7 + azar() * 0.6,
      fill: tonos[Math.floor(azar() * tonos.length)],
    };
  });
  const punta = enCurva(rama, 1);
  for (const desvio of [-30, 0, 30]) {
    hojas.push({
      x: punta.x,
      y: punta.y,
      giro: punta.angulo + desvio,
      escala: 0.8 + azar() * 0.4,
      fill: tonos[Math.floor(azar() * tonos.length)],
    });
  }
  return hojas;
};

const ramas = grupos.map((ramasGrupo, i) => ({
  origen: ramasGrupo[0].desde,
  retraso: `${-i * 2.3}s`,
  trazos: ramasGrupo.map(
    (r) => `M${r.desde.join(' ')} Q${r.control.join(' ')} ${r.hasta.map((n) => n.toFixed(1)).join(' ')}`,
  ),
  grosores: ramasGrupo.map((r) => r.grosor),
  hojas: ramasGrupo.flatMap(hojasDe),
  // Unas pocas flores blancas entre las hojas.
  flores: ramasGrupo.slice(1).map((r) => {
    const { x, y } = enCurva(r, 0.5 + azar() * 0.4);
    return { x, y, giro: Math.round(azar() * 72) };
  }),
}));

// Hojas y pétalos que se desprenden de las ramas.
const caidas = Array.from({ length: 18 }, (_, i) => ({
  left: `${10 + azar() * 80}%`,
  top: `${8 + azar() * 40}%`,
  dx: `${Math.round(-90 + azar() * 140)}px`,
  dy: `${Math.round(320 + azar() * 160)}px`,
  dur: `${(8 + azar() * 7).toFixed(1)}s`,
  delay: `${(-azar() * 15).toFixed(1)}s`,
  size: i % 3 === 0 ? 'size-4' : i % 3 === 1 ? 'size-3' : 'size-2.5',
  color: i % 4 === 0 ? 'bg-rosa-600/80' : i % 2 ? 'bg-rosa-400/90' : 'bg-rosa',
}));
---

<div class:list={['pointer-events-none', clase ?? 'relative']} aria-hidden="true">
  <svg viewBox="0 0 520 420" class="size-full overflow-visible">
    {ramas.map((g) => (
      <g class="animate-mecer" style={`transform-origin:${g.origen[0]}px ${g.origen[1]}px;animation-delay:${g.retraso}`}>
        {g.trazos.map((d, i) => (
          <path d={d} fill="none" stroke="var(--color-cafe)" stroke-width={g.grosores[i]} stroke-linecap="round" />
        ))}
        {g.hojas.map((h) => (
          <g transform={`translate(${h.x.toFixed(1)} ${h.y.toFixed(1)}) rotate(${h.giro.toFixed(0)}) scale(${h.escala.toFixed(2)})`}>
            <path d="M0 0 C7 -9 22 -9 30 0 C22 9 7 9 0 0Z" fill={h.fill} />
            <path d="M3 0 H25" stroke="white" stroke-opacity="0.35" stroke-width="1" />
          </g>
        ))}
        {g.flores.map((f) => (
          <g transform={`translate(${f.x.toFixed(1)} ${f.y.toFixed(1)}) rotate(${f.giro})`}>
            {[0, 72, 144, 216, 288].map((a) => (
              <ellipse cx="0" cy="-6" rx="3.5" ry="6" fill="white" fill-opacity="0.85" transform={`rotate(${a})`} />
            ))}
            <circle r="2.5" fill="var(--color-lima)" />
          </g>
        ))}
      </g>
    ))}
  </svg>

  {caidas.map((c) => (
    <span
      class:list={['animate-caer absolute rounded-[70%_0] opacity-0', c.size, c.color]}
      style={`left:${c.left};top:${c.top};--dx:${c.dx};--dy:${c.dy};animation-duration:${c.dur};animation-delay:${c.delay}`}
    />
  ))}
</div>

---
import Flecha from '../Flecha.astro';
import { Image } from 'astro:assets';
import { enlaces } from '../../config/site';
import foto1 from '../../assets/galeria/jornada-1.jpg';
import foto2 from '../../assets/galeria/jornada-2.jpg';
import foto3 from '../../assets/galeria/jornada-3.jpg';
import foto4 from '../../assets/galeria/jornada-4.jpg';
import foto5 from '../../assets/galeria/jornada-5.jpg';
import foto6 from '../../assets/galeria/jornada-6.jpg';

// TODO: reemplazar por las fotos originales de las jornadas (estas son recortes provisionales).
const fotos = [
  {
    src: foto4,
    alt: 'Grupo de voluntarios caminando con plantas hacia el sitio de siembra',
    clase: 'md:col-span-2 md:row-span-2',
  },
  { src: foto1, alt: 'Voluntaria sembrando un árbol joven', clase: '' },
  { src: foto2, alt: 'Banners de Árboles para El Salvador entre la vegetación', clase: '' },
  { src: foto3, alt: 'Voluntario plantando un árbol en el terreno', clase: '' },
  { src: foto6, alt: 'Voluntaria con un árbol recién sembrado', clase: '' },
  { src: foto5, alt: 'Dos participantes junto a un árbol que acaban de sembrar', clase: '' },
];
---

<section id="siembra" class="bg-crema py-28" aria-labelledby="siembra-titulo">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="mb-12 grid gap-6 lg:grid-cols-2 lg:items-end">
      <div>
        <p class="eyebrow text-olivo">Únete a reforestar</p>
        <h2 id="siembra-titulo" class="titulo mt-4 text-[clamp(3rem,7vw,6rem)]">
          Pon tus manos <em class="block font-serif font-normal tracking-normal text-verde">en la tierra.</em>
        </h2>
      </div>
      <p class="text-lg text-marino/70">
        Instituciones, escuelas, comunidades y voluntarios ya están sembrando en todo el país. Cada árbol que se cuida
        hoy es sombra, agua y suelo para mañana.
      </p>
    </div>

    <ul class="grid auto-rows-[220px] grid-cols-1 gap-3 sm:grid-cols-2 md:auto-rows-[240px] md:grid-cols-3">
      {fotos.map((f) => (
        <li class:list={['overflow-hidden rounded-[1.75rem] ring-1 ring-marino/10', f.clase]}>
          <Image
            src={f.src}
            alt={f.alt}
            widths={[400, 605]}
            sizes="(min-width: 768px) 33vw, 100vw"
            class="size-full object-cover transition duration-500 hover:scale-105"
          />
        </li>
      ))}
    </ul>

    <article class="mt-4 flex flex-col gap-6 rounded-[2.5rem] bg-pasto p-8 md:flex-row md:items-center md:justify-between md:p-12">
      <div class="max-w-2xl">
        <p class="eyebrow">Recurso descargable</p>
        <h2 class="titulo mt-4 text-5xl md:text-6xl">Guía para la reforestación</h2>
        <p class="mt-4 text-marino/75">
          Cómo elegir la especie, preparar el terreno, sembrar y dar mantenimiento para que tu árbol sobreviva.
        </p>
      </div>
      <a
        href={enlaces.guiaReforestacion}
        download
        class="inline-flex shrink-0 items-center justify-between gap-6 rounded-3xl border-2 border-marino px-6 py-5 font-bold transition hover:bg-marino hover:text-pasto"
      >
        <span>Descargar PDF</span>
        <Flecha direccion="abajo" class="size-6" />
      </a>
    </article>
  </div>
</section>

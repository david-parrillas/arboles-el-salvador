---
import type { ResumenEspecie } from '../../lib/portaldeb/resumen';

interface Props {
  especies: ResumenEspecie[];
}

// Se resuelve en el build: es contenido decorativo y no necesita refrescarse en vivo.
const respaldo = ['Maquilishuat', 'Cedro', 'Caoba', 'Conacaste', 'Bálsamo', 'Ceiba', 'Madrecacao', 'Guachipilín'];
const nombres = Astro.props.especies.length
  ? [...Astro.props.especies]
      .sort((a, b) => b.viveros - a.viveros)
      .slice(0, 18)
      .map((e) => e.nombreComun.split(',')[0])
  : respaldo;
---

<div class="relative -rotate-2 overflow-hidden border-y-2 border-marino bg-lima py-3 text-marino" aria-hidden="true">
  <div class="animate-marquee flex w-max">
    {[0, 1].map(() => (
      <ul class="flex shrink-0 items-center">
        {nombres.map((n) => (
          <li class="titulo px-6 text-3xl whitespace-nowrap md:text-4xl">{n}</li>
        ))}
      </ul>
    ))}
  </div>
</div>
